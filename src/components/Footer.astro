---
import { sitePath } from "@/lib/site-path";
---

<footer class="site-footer">
  <div class="footer-accent" aria-hidden="true"></div>
  <div class="footer-grid shell">
    <section class="footer-intro" aria-labelledby="footer-brand-name">
      <a class="brand footer-brand" href={sitePath("/")} aria-label="威馬康健首頁">
        <span class="brand-mark" aria-hidden="true">W</span>
        <span class="brand-copy"><strong id="footer-brand-name">威馬康健</strong><small>WIMA CARE</small></span>
      </a>
      <p class="footer-statement">以植萃之力，守護日常健康</p>
      <nav class="footer-socials" aria-label="威馬康健社群平台">
        <a class="footer-social-icon" href="https://www.facebook.com/wimacarevegan" target="_blank" rel="noreferrer" aria-label="Facebook（於新分頁開啟）" title="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5V7c0-1.1.7-1.5 1.7-1.5H18V2.2c-.8-.1-1.8-.2-3.1-.2C11.8 2 10 3.9 10 7.2v1.3H7V12h3v10h4V12h3.4l.6-3.5H14Z" /></svg>
        </a>
        <a class="footer-social-icon" href="https://www.youtube.com/@wimacare" target="_blank" rel="noreferrer" aria-label="YouTube（於新分頁開啟）" title="YouTube">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 7.1a3 3 0 0 0-2.1-2.1C17.7 4.5 12 4.5 12 4.5S6.3 4.5 4.5 5a3 3 0 0 0-2.1 2.1C2 8.9 2 12 2 12s0 3.1.4 4.9A3 3 0 0 0 4.5 19c1.8.5 7.5.5 7.5.5s5.7 0 7.5-.5a3 3 0 0 0 2.1-2.1C22 15.1 22 12 22 12s0-3.1-.4-4.9ZM10 15.3V8.7l5.8 3.3-5.8 3.3Z" /></svg>
        </a>
        <a class="footer-social-icon" href="https://line.me/R/ti/p/@910mkdxc" target="_blank" rel="noreferrer" aria-label="LINE 客服（於新分頁開啟）" title="LINE 客服">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C6.5 3 2 6.7 2 11.2c0 4 3.6 7.3 8.5 8 .4.1.9.3 1 .7l.1.8 1.1-.6c5.5-3 9.3-5.7 9.3-9.1C22 6.7 17.5 3 12 3Zm-4.2 9.7H5.5V8.4h1.1v3.3h1.2v1Zm1.8 0H8.5V8.4h1.1v4.3Zm4.5 0H13l-1.6-2.3v2.3h-1.1V8.4h1.1l1.6 2.3V8.4h1.1v4.3Zm3.6-3.3h-1.5v.6h1.4v1h-1.4v.7h1.5v1h-2.6V8.4h2.6v1Z" /></svg>
        </a>
        <a class="footer-social-icon" href="mailto:wimacare.ec@gmail.com" aria-label="寄送電子郵件至 wimacare.ec@gmail.com" title="wimacare.ec@gmail.com">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z" /></svg>
        </a>
      </nav>
    </section>

    <nav class="footer-column" aria-labelledby="footer-nav-title">
      <h2 id="footer-nav-title">網站導覽</h2>
      <a href={sitePath("/about/")}>品牌故事</a>
      <a href={sitePath("/products/")}>產品介紹</a>
      <a href={sitePath("/news/")}>最新消息</a>
      <a href={sitePath("/channels/")}>實體通路</a>
      <a href={sitePath("/contact/")}>聯絡我們</a>
      <a href="https://www.104.com.tw/company/1a2x6bl5yl" target="_blank" rel="noreferrer">徵才資訊</a>
    </nav>

    <section class="footer-column" aria-labelledby="footer-contact-title">
      <h2 id="footer-contact-title">聯絡資訊</h2>
      <dl class="footer-contact-list">
        <div><dt>客服電話</dt><dd>0800-58-58-53</dd></div>
        <div><dt>官方電郵</dt><dd>service@oin.com.tw</dd></div>
        <div><dt>服務時間</dt><dd>週一至週五 09:00–18:00</dd></div>
      </dl>
    </section>

  </div>

  <div class="footer-bottom shell">
    <span>© 威馬康健國際醫學生技有限公司 All Rights Reserved. 統一編號 83467360</span>
    <span><a href={sitePath("/privacy/")}>隱私權政策</a><i aria-hidden="true">·</i><a href={sitePath("/contact/")}>聯絡我們</a></span>
  </div>
</footer>
