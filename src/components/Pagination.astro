---
import { sitePath } from "@/lib/site-path";

interface Props {
  basePath: string;
  currentPage: number;
  totalPages: number;
}

const { basePath, currentPage, totalPages } = Astro.props;
const pageHref = (page: number) =>
  page === 1 ? sitePath(`${basePath}/`) : sitePath(`${basePath}/page/${page}/`);
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="文章分頁">
    {currentPage > 1 && <a class="pagination-direction" href={pageHref(currentPage - 1)}>← 上一頁</a>}
    <div class="pagination-pages">
      {Array.from({ length: totalPages }, (_, index) => {
        const page = index + 1;
        return page === currentPage ? (
          <span class="pagination-page is-current" aria-current="page">{page}</span>
        ) : (
          <a class="pagination-page" href={pageHref(page)} aria-label={`前往第 ${page} 頁`}>{page}</a>
        );
      })}
    </div>
    {currentPage < totalPages && <a class="pagination-direction" href={pageHref(currentPage + 1)}>下一頁 →</a>}
  </nav>
)}
