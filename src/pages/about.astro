---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { sitePath } from "@/lib/site-path";
---

<BaseLayout title="關於我們｜威馬康健" description="認識威馬康健的品牌故事、素食保健理念、專業研發團隊與品質承諾。" pageClass="interior-page about-page">
  <PageHero background eyebrow="ABOUT WIMA CARE" title="關於我們" description="從純粹植萃、專業研發到嚴謹製程，用科學與善念守護每一天的健康選擇。" />

  <section class="section about-intro">
    <div class="shell">
      <figure class="about-lead-visual">
        <img src={sitePath("/about/brand-hero.jpg")} alt="威馬康健純素科學與精準營養品牌理念" />
      </figure>
      <div class="about-manifesto">
        <p class="eyebrow">PURE BOTANICAL · PRECISE NUTRITION</p>
        <h2>威馬康健 <span>WIMACARE</span></h2>
        <p class="about-formula"><strong>專家研發</strong><i>×</i><strong>科學實證</strong><i>×</i><strong>安心檢驗</strong></p>
        <p class="about-manifesto-note">用科學守護您的日常健康！</p>
      </div>
    </div>
  </section>

  <section class="section about-feature-section">
    <div class="shell about-feature-grid">
      <div class="about-feature-copy">
        <p class="eyebrow">THE PLANT-BASED ANSWER</p>
        <h2>純植物來源的<br />專家級營養解方。</h2>
        <p>全球健康趨勢指出，傳統保健品的動物性原料常潛藏環境荷爾蒙、抗生素與重金屬污染風險。</p>
        <p>深耕醫療保健市場數十年的 <strong>威馬康健 WIMACARE</strong>，憑藉頂尖專業團隊，推出「專業全素食保健系列」，以純植物來源的專家級解方，提供高效、零負擔的精準營養。</p>
      </div>
      <figure class="about-feature-media">
        <img src={sitePath("/about/research-team.jpg")} alt="專業生化與營養學團隊進行研究" loading="lazy" />
        <figcaption>以專業生化與營養學團隊，打造符合健康需求的優質保健食品。</figcaption>
      </figure>
    </div>
  </section>

  <section class="section about-feature-section about-feature-tinted">
    <div class="shell about-feature-grid">
      <figure class="about-feature-media about-facility-media">
        <img src={sitePath("/about/cgmp-facility.png")} alt="cGMP 藥廠等級生產工廠與製程環境" loading="lazy" />
        <figcaption><strong>cGMP 藥廠等級生產工廠</strong>，從原料溯源、生產封裝到出廠檢驗層層把關。</figcaption>
      </figure>
      <div class="about-feature-copy about-feature-copy-gold">
        <p class="eyebrow">SCIENCE & QUALITY</p>
        <h2>瑞士研發能量，<br />藥廠級製程把關</h2>
        <p>威馬康健集結 <strong>瑞士專家團隊 Sinoba CH GmbH.</strong> 的研發實力，交由 <strong>美國 cGMP 藥廠級認證工廠</strong> 生產，專為台灣大眾與素食族群量身打造。</p>
        <div class="about-quality-points">
          <span>原料溯源</span><span>專業研發</span><span>嚴謹製程</span><span>出廠檢驗</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-feature-section">
    <div class="shell about-feature-grid about-brand-story-grid">
      <div class="about-feature-copy">
        <p class="eyebrow">OUR BRAND STORY</p>
        <h2>安心的來源，<br />才是健康的根本</h2>
        <p>威馬康健隸屬於頂霖集團，奉行「食材的健康，才是個人健康根源」的理念。</p>
        <p>以不殺生的慈悲心與地球永續關懷出發，開發素食保健食品，打造黃金配方、精選原料及製程。</p>
        <p>這份營養專業與純淨善念的堅持，讓威馬康健成為台灣全素食保健的綠色權威。我們以專業團隊嚴格為品質把關，讓您用得安心，身體健康、開心愉悅。</p>
      </div>
      <figure class="about-feature-media about-brand-media">
        <img src={sitePath("/about/brand-health.jpg")} alt="威馬康健全素保健、地球永續、純淨安心與專業團隊理念" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="about-promise">
    <div class="shell">
      <p class="eyebrow light">OUR NUTRITION PROMISE</p>
      <h2>從現在開始，用植萃之力，<br />守護您的日常健康。</h2>
      <div class="about-promise-grid">
        <article><b>01</b><h3>黃金配方</h3><p>真正有感、有效吸收的專業營養配方。</p></article>
        <article><b>02</b><h3>日常補給</h3><p>補足日常飲食中容易缺乏的關鍵營養。</p></article>
        <article><b>03</b><h3>多元需求</h3><p>多元保健食品，滿足不同族群的健康需求。</p></article>
        <article><b>04</b><h3>安心品質</h3><p>從原料到成品嚴格把關，安心無負擔。</p></article>
      </div>
    </div>
  </section>

  <section class="section about-video-section">
    <div class="shell">
      <div class="about-video-heading">
        <p class="eyebrow">WIMA CARE FILM</p>
        <h2>認識威馬康健</h2>
      </div>
      <div class="about-video-frame">
        <iframe src="https://www.youtube-nocookie.com/embed/ncU6AmdLiG0?rel=0&amp;start=1" title="威馬康健品牌影片" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <section class="section about-company-section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">COMPANY INFORMATION</p>
        <h2 class="section-title">企業資訊</h2>
      </div>
      <div class="about-company-grid">
        <article>
          <span>WIMA CARE</span>
          <h3>威馬康健國際醫學生技有限公司</h3>
          <p>統一編號：<strong>83467360</strong></p>
        </article>
        <article>
          <span>NATTIER BIOTECH</span>
          <h3>九溢國際有限公司</h3>
          <p>統一編號：<strong>27735960</strong></p>
          <a href="https://nattier.com" target="_blank" rel="noopener noreferrer">瑞士生技細胞素官網 nattier.com ↗</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
