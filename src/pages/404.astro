---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/lib/site-path";
---
<BaseLayout title="找不到頁面｜威馬康健" description="您造訪的頁面不存在。" noindex={true} pageClass="interior-page error-page">
  <section class="page-hero"><div class="shell"><p class="eyebrow">404 · PAGE NOT FOUND</p><h1>找不到這個頁面</h1><p class="lede">網址可能已變更，或內容尚未公開。</p><a class="button" href={sitePath("/")}>回到首頁 →</a></div></section>
</BaseLayout>
