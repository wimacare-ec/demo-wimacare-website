---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { sitePath } from "@/lib/site-path";

const channelGroups = [
  {
    id: "community-pharmacy",
    label: "社區藥局",
    eyebrow: "COMMUNITY PHARMACY",
    description: "透過在地社區藥局的專業諮詢服務，依您的日常保養需求選擇合適的保健系列。",
    href: sitePath("/products-RX/"),
    products: [
      { pack: "VEGETARIAN CARE", title: "素食保健系列", description: "以「植萃營養，安心有效」為品牌理念，打造專業的素食保健食品", image: sitePath("/products/veg-RX.jpg"), series: "vegetarian" },
      { pack: "DAILY CARE", title: "葷食保健系列", description: "適合建立每日保養習慣的基礎，對應忙碌生活與多元日常需求。", image: sitePath("/products/non-veg-RX.jpg"), series: "non-vegetarian" },
    ],
  },
  {
    id: "chain-drugstore",
    label: "連鎖藥妝",
    eyebrow: "CHAIN DRUGSTORE",
    description: "在連鎖藥妝通路也能購買到威馬康健的保健系列，實際品項依各門店現場為準。",
    href: sitePath("/products-PCS/"),
    products: [
      { pack: "VEGETARIAN CARE", title: "素食保健系列", description: "以「植萃營養，安心有效」為品牌理念，打造專業的素食保健食品", image: sitePath("/products/veg-KA.jpg"), series: "vegetarian" },
      { pack: "DAILY CARE", title: "葷食保健系列", description: "適合建立每日保養習慣的基礎，對應忙碌生活與多元日常需求。", image: sitePath("/products/non-veg-KA.jpg"), series: "non-vegetarian" },
    ],
  },
];
---

<BaseLayout title="產品介紹｜威馬康健" description="依社區藥局與連鎖藥妝通路瀏覽威馬康健素食及葷食保健系列。" pageClass="interior-page products-page">
  <PageHero background eyebrow="OUR PRODUCTS" title="產品介紹" description="我們的保健系列滿足各年齡族群的多樣需求，基礎保養、成長發育、機能代謝、青春美麗、充沛活力等多樣功效。" />
  <section class="section product-channels" aria-label="產品販售通路">
    <div class="shell">
      {channelGroups.map((channel, index) => (
        <section
          id={channel.id}
          class="product-channel-section"
          aria-labelledby={`${channel.id}-title`}
        >
          <header class="product-channel-heading">
            <div class="product-channel-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
            <div>
              <p class="eyebrow">{channel.eyebrow}</p>
              <h2 id={`${channel.id}-title`}>{channel.label}</h2>
              <p>{channel.description}</p>
            </div>
          </header>

          <div class="product-grid">
            {channel.products.map((product) => (
              <article class:list={["product-card", { "product-card--with-image": Boolean(product.image) }]}>
                <div class:list={["visual", { "is-product-image": Boolean(product.image) }]}>
                  {product.image ? <img src={product.image} alt={`${product.title}商品陳列`} loading="lazy" /> : <div class="mini-pack">{product.pack}</div>}
                </div>
                <small>{channel.label} · WIMA CARE</small>
                <h2>{product.title}</h2>
                <p>{product.description}</p>
                {channel.href && (
                  <a class="product-card-cta" href={`${channel.href}?series=${product.series}#rx-product-filter`}>瞭解更多 <span aria-hidden="true">&gt;&gt;</span></a>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}

      <div class="notice"><strong>產品資訊聲明：</strong>授權通路所販售的商品項目，依各門店現場為準，建議前往選購時，可致電瞭解或洽詢線上客服。</div>
    </div>
  </section>
</BaseLayout>
