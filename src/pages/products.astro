---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { sitePath } from "@/lib/site-path";

const channelGroups = [
  {
    id: "community-pharmacy",
    label: "社區藥局",
    eyebrow: "COMMUNITY PHARMACY",
    description: "透過在地社區藥局的專業服務，依日常保養需求選擇合適的威馬康健產品系列。",
    products: [
      { pack: "VEGETARIAN CARE", title: "素食保健系列", description: "以「植萃營養，安心有效」為品牌理念，打造專業的素食保健食品", image: undefined },
      { pack: "DAILY CARE", title: "葷食保健系列", description: "適合建立每日保養習慣的基礎，對應忙碌生活與多元日常需求。", image: undefined },
    ],
  },
  {
    id: "chain-drugstore",
    label: "連鎖藥妝",
    eyebrow: "CHAIN DRUGSTORE",
    description: "於連鎖藥妝通路瀏覽威馬康健素食與葷食保健系列，實際品項依各門店現場為準。",
    products: [
      { pack: "VEGETARIAN CARE", title: "素食保健系列", description: "以「植萃營養，安心有效」為品牌理念，打造專業的素食保健食品", image: sitePath("/products/veg-KA.jpg") },
      { pack: "DAILY CARE", title: "葷食保健系列", description: "適合建立每日保養習慣的基礎，對應忙碌生活與多元日常需求。", image: sitePath("/products/non-veg-KA.jpg") },
    ],
  },
];
---

<BaseLayout title="產品介紹｜威馬康健" description="依社區藥局與連鎖藥妝通路瀏覽威馬康健素食及葷食保健系列。" pageClass="interior-page products-page">
  <PageHero background eyebrow="OUR PRODUCTS" title="產品介紹" description="依販售通路瀏覽威馬康健產品系列；正式上線內容將補齊核准品名、規格、成分與注意事項。" />
  <section class="section product-channels" aria-label="產品販售通路">
    <div class="shell">
      {channelGroups.map((channel, index) => (
        <section
          id={channel.id}
          class="product-channel-section"
          aria-labelledby={`${channel.id}-title`}
        >
          <header class="product-channel-heading">
            <div class="product-channel-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
            <div>
              <p class="eyebrow">{channel.eyebrow}</p>
              <h2 id={`${channel.id}-title`}>{channel.label}</h2>
              <p>{channel.description}</p>
            </div>
          </header>

          <div class="product-grid">
            {channel.products.map((product) => (
              <article class:list={["product-card", { "product-card--with-image": Boolean(product.image) }]}>
                <div class:list={["visual", { "is-product-image": Boolean(product.image) }]}>
                  {product.image ? <img src={product.image} alt={`${product.title}商品陳列`} loading="lazy" /> : <div class="mini-pack">{product.pack}</div>}
                </div>
                <small>{channel.label} · WIMA CARE</small>
                <h2>{product.title}</h2>
                <p>{product.description}</p>
              </article>
            ))}
          </div>
        </section>
      ))}

      <div class="notice"><strong>產品資訊聲明：</strong>本頁目前為網站架構與內容欄位示意，不構成醫療建議或功效保證。正式產品內容須經品牌、法務與法規審核後發布。</div>
    </div>
  </section>
</BaseLayout>
