---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import channelData from "@/data/channels.json";

const serializedChannelData = JSON.stringify(channelData).replace(/</g, "\\u003c");
---

<BaseLayout
  title="查詢實體授權通路｜威馬康健 WIMA CARE"
  description="尋找離您最近的威馬康健 WIMA CARE 正式授權合作通路！提供全台藥局、診所及實體藥妝門市查詢服務，讓您輕鬆就近購買高品質保健食品。前往前建議先致電確認品項與庫存。"
  pageClass="interior-page channels-page-body"
>
  <div class="channels-page">
    <PageHero
      background
      eyebrow="PHYSICAL CHANNELS"
      title="實體通路"
      description="選擇銷售渠道、縣市與行政區，快速找到鄰近的威馬康健正式授權合作通路。"
    />

    <section class="section channel-directory" aria-labelledby="channel-directory-title">
      <div class="shell">
        <header class="channel-directory-heading">
          <p class="eyebrow">AUTHORIZED CHANNELS</p>
          <h2 id="channel-directory-title">查詢授權通路</h2>
          <p>實際販售品項與庫存依各門店現場為準，前往前建議先致電確認。</p>
        </header>

        <div class="channel-toolbar">
          <div class="channel-toolbar-section">
            <p class="channel-toolbar-label" id="channel-type-label">銷售渠道</p>
            <div class="channel-type-tabs" role="tablist" aria-labelledby="channel-type-label">
              <button class="channel-type-tab is-active" type="button" role="tab" aria-selected="true" data-channel="pharmacyClinic">藥局／診所</button>
              <button class="channel-type-tab" type="button" role="tab" aria-selected="false" data-channel="physicalDrugstore">實體藥妝</button>
              <button class="channel-type-tab" type="button" role="tab" aria-selected="false" data-channel="other">其他通路</button>
            </div>
          </div>

          <div class="channel-toolbar-section channel-location-section">
            <p class="channel-toolbar-label">所在地區</p>
            <div class="channel-location-filters">
              <label class="channel-select-field">
                <span>縣市</span>
                <select id="channel-city" aria-controls="channel-store-grid">
                  <option value="">全部縣市</option>
                </select>
              </label>
              <label class="channel-select-field">
                <span>行政區</span>
                <select id="channel-district" aria-controls="channel-store-grid" disabled>
                  <option value="">請先選擇縣市</option>
                </select>
              </label>
            </div>
          </div>
        </div>

        <p class="channel-result-summary" id="channel-result-summary" aria-live="polite"></p>
        <div class="channel-directory-grid" id="channel-store-grid"></div>
        <div class="empty-state" id="channel-empty" hidden>目前沒有符合條件的授權通路，請調整篩選條件。</div>
        <nav class="channel-pagination" id="channel-pagination" aria-label="授權通路分頁"></nav>

        <div class="notice">通路資訊可能因門市營運狀況而異；若發現資料需要更新，歡迎透過聯絡頁面告知我們。</div>
      </div>
    </section>
  </div>

  <script id="channel-data" type="application/json" is:inline set:html={serializedChannelData}></script>
  <script>
    type ChannelKey = "pharmacyClinic" | "physicalDrugstore" | "other";
    type Store = {
      name: string;
      city: string;
      district: string;
      address: string;
      phone: string;
      hasLocation: boolean;
      photo: string;
      description: string;
      link: string;
    };

    const PAGE_SIZE = 12;
    const channelLabels: Record<ChannelKey, string> = {
      pharmacyClinic: "藥局／診所",
      physicalDrugstore: "實體藥妝",
      other: "其他通路",
    };
    const dataElement = document.querySelector<HTMLScriptElement>("#channel-data");
    const storeData = JSON.parse(dataElement?.textContent || "{}") as Record<ChannelKey, Store[]>;
    const citySelect = document.querySelector<HTMLSelectElement>("#channel-city");
    const districtSelect = document.querySelector<HTMLSelectElement>("#channel-district");
    const grid = document.querySelector<HTMLElement>("#channel-store-grid");
    const empty = document.querySelector<HTMLElement>("#channel-empty");
    const summary = document.querySelector<HTMLElement>("#channel-result-summary");
    const pagination = document.querySelector<HTMLElement>("#channel-pagination");
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-channel]"));

    let activeChannel: ChannelKey = "pharmacyClinic";
    let currentPage = 1;

    const sortLabels = (labels: string[]) => labels.sort((a, b) => a.localeCompare(b, "zh-Hant"));
    const unique = (values: string[]) => sortLabels([...new Set(values.filter(Boolean))]);

    const createOption = (label: string, value = "") => {
      const option = document.createElement("option");
      option.value = value;
      option.textContent = label;
      return option;
    };

    const getChannelStores = () => storeData[activeChannel] || [];

    const populateCityOptions = () => {
      if (!citySelect || !districtSelect) return;
      const cities = unique(getChannelStores().filter((store) => store.hasLocation).map((store) => store.city));
      citySelect.replaceChildren(createOption(cities.length ? "全部縣市" : "此渠道無地區資料"));
      cities.forEach((city) => citySelect.append(createOption(city, city)));
      citySelect.disabled = cities.length === 0;
      districtSelect.replaceChildren(createOption(cities.length ? "請先選擇縣市" : "此渠道無行政區資料"));
      districtSelect.disabled = true;
    };

    const populateDistrictOptions = () => {
      if (!citySelect || !districtSelect) return;
      const city = citySelect.value;
      if (!city) {
        districtSelect.replaceChildren(createOption("請先選擇縣市"));
        districtSelect.disabled = true;
        return;
      }
      const districts = unique(
        getChannelStores()
          .filter((store) => store.hasLocation && store.city === city)
          .map((store) => store.district),
      );
      districtSelect.replaceChildren(createOption("全部行政區"));
      districts.forEach((district) => districtSelect.append(createOption(district, district)));
      districtSelect.disabled = districts.length === 0;
    };

    const getFilteredStores = () => {
      const city = citySelect?.value || "";
      const district = districtSelect?.value || "";
      return [...getChannelStores()]
        .filter((store) => (!city || store.city === city) && (!district || store.district === district))
        .sort((a, b) => {
          const locationOrder = `${a.city}${a.district}`.localeCompare(`${b.city}${b.district}`, "zh-Hant");
          return locationOrder || a.name.localeCompare(b.name, "zh-Hant");
        });
    };

    const addMetaTag = (container: HTMLElement, label: string) => {
      if (!label) return;
      const tag = document.createElement("span");
      tag.textContent = label;
      container.append(tag);
    };

    const createStoreCard = (store: Store) => {
      const card = document.createElement("article");
      card.className = "channel-store-card";

      if (store.photo) {
        const image = document.createElement("img");
        image.className = "channel-store-photo";
        image.src = store.photo;
        image.alt = `${store.name}通路圖片`;
        image.loading = "lazy";
        card.append(image);
      }

      const body = document.createElement("div");
      body.className = "channel-store-body";
      const meta = document.createElement("div");
      meta.className = "channel-store-meta";
      addMetaTag(meta, channelLabels[activeChannel]);
      addMetaTag(meta, [store.city, store.district].filter(Boolean).join("・"));

      const title = document.createElement("h3");
      title.textContent = store.name;
      body.append(meta, title);

      if (store.description) {
        const description = document.createElement("p");
        description.className = "channel-store-description";
        description.textContent = store.description;
        body.append(description);
      }

      if (store.address || store.phone) {
        const details = document.createElement("dl");
        details.className = "channel-store-details";
        if (store.address) {
          const addressLabel = document.createElement("dt");
          addressLabel.textContent = "地址";
          const addressValue = document.createElement("dd");
          addressValue.textContent = store.address;
          details.append(addressLabel, addressValue);
        }
        if (store.phone) {
          const phoneLabel = document.createElement("dt");
          phoneLabel.textContent = "電話";
          const phoneValue = document.createElement("dd");
          const phoneLink = document.createElement("a");
          phoneLink.href = `tel:${store.phone.replace(/[^+\d]/g, "")}`;
          phoneLink.textContent = store.phone;
          phoneValue.append(phoneLink);
          details.append(phoneLabel, phoneValue);
        }
        body.append(details);
      }

      card.append(body);

      if (store.hasLocation && store.address) {
        const map = document.createElement("div");
        map.className = "channel-store-map";
        const query = encodeURIComponent(`${store.name} ${store.address}`);
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.google.com/maps?q=${query}&z=16&output=embed`;
        iframe.title = `${store.name} Google 地圖`;
        iframe.loading = "lazy";
        iframe.referrerPolicy = "no-referrer-when-downgrade";
        iframe.setAttribute("allowfullscreen", "");
        map.append(iframe);

        const mapLink = document.createElement("a");
        mapLink.className = "channel-map-link";
        mapLink.href = `https://www.google.com/maps/search/?api=1&query=${query}`;
        mapLink.target = "_blank";
        mapLink.rel = "noreferrer";
        mapLink.textContent = "在 Google 地圖查看 ↗";
        map.append(mapLink);
        card.append(map);
      } else if (store.link) {
        const externalLink = document.createElement("a");
        externalLink.className = "channel-map-link channel-store-external-link";
        externalLink.href = store.link;
        externalLink.target = "_blank";
        externalLink.rel = "noreferrer";
        externalLink.textContent = "查看通路資訊 ↗";
        card.append(externalLink);
      }

      return card;
    };

    const createPaginationButton = (label: string, page: number, options: { current?: boolean; disabled?: boolean; label?: string } = {}) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "channel-pagination-button";
      button.textContent = label;
      button.disabled = Boolean(options.disabled);
      if (options.current) {
        button.classList.add("is-current");
        button.setAttribute("aria-current", "page");
      }
      if (options.label) button.setAttribute("aria-label", options.label);
      button.addEventListener("click", () => {
        currentPage = page;
        render();
        document.querySelector(".channel-result-summary")?.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
          block: "start",
        });
      });
      return button;
    };

    const renderPagination = (totalPages: number) => {
      if (!pagination) return;
      pagination.replaceChildren();
      pagination.hidden = totalPages <= 1;
      if (totalPages <= 1) return;

      pagination.append(createPaginationButton("上一頁", currentPage - 1, { disabled: currentPage === 1 }));
      const visiblePages = new Set([1, totalPages, currentPage - 2, currentPage - 1, currentPage, currentPage + 1, currentPage + 2].filter((page) => page >= 1 && page <= totalPages));
      let previousPage = 0;
      [...visiblePages].sort((a, b) => a - b).forEach((page) => {
        if (previousPage && page - previousPage > 1) {
          const ellipsis = document.createElement("span");
          ellipsis.className = "channel-pagination-ellipsis";
          ellipsis.textContent = "…";
          pagination.append(ellipsis);
        }
        pagination.append(createPaginationButton(String(page), page, {
          current: page === currentPage,
          label: `前往第 ${page} 頁`,
        }));
        previousPage = page;
      });
      pagination.append(createPaginationButton("下一頁", currentPage + 1, { disabled: currentPage === totalPages }));
    };

    const render = () => {
      if (!grid || !empty || !summary) return;
      const stores = getFilteredStores();
      const totalPages = Math.max(1, Math.ceil(stores.length / PAGE_SIZE));
      currentPage = Math.min(Math.max(currentPage, 1), totalPages);
      const pageStores = stores.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

      grid.replaceChildren(...pageStores.map(createStoreCard));
      grid.hidden = pageStores.length === 0;
      empty.hidden = pageStores.length > 0;
      summary.textContent = stores.length
        ? `共 ${stores.length} 筆授權通路，目前顯示第 ${currentPage}／${totalPages} 頁`
        : "目前沒有符合條件的授權通路";
      renderPagination(stores.length ? totalPages : 0);
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        activeChannel = (tab.dataset.channel || "pharmacyClinic") as ChannelKey;
        currentPage = 1;
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-selected", String(active));
        });
        populateCityOptions();
        render();
      });
    });

    citySelect?.addEventListener("change", () => {
      currentPage = 1;
      populateDistrictOptions();
      render();
    });
    districtSelect?.addEventListener("change", () => {
      currentPage = 1;
      render();
    });

    populateCityOptions();
    render();
  </script>
</BaseLayout>
