---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import ArticleArchive from "@/components/ArticleArchive.astro";
import { archivePageEntries, totalArchivePages } from "@/lib/pagination";

const categories = ["保健新知", "飲食指南", "成分功效"];
const knowledge = (await getCollection("knowledge", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const entries = archivePageEntries(knowledge, 1);
const totalPages = totalArchivePages(knowledge.length);
---

<BaseLayout title="保健新知、飲食指南與成分功效｜威馬康健 WIMA CARE" description="威馬康健為您整理專業的健康知識與保健指南，包含關鍵營養素的功效解析、營養補充及保健食品選購原則，協助您建立適合自己的健康知識基礎。" pageClass="interior-page knowledge-list-page">
  <PageHero background eyebrow="HEALTH KNOWLEDGE" title="健康知識" description="以清楚易懂的方式整理保健新知、飲食指南與成分功效，協助您建立適合自己的健康知識基礎。" />
  <section class="section"><div class="shell">
    <ArticleArchive entries={entries} categories={categories} basePath="/knowledge" currentPage={1} totalPages={totalPages} summaryLabel="篇文章" emptyMessage="目前尚無健康知識文章，內容準備中。" />
  </div></section>
</BaseLayout>
