---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/lib/site-path";
import PageHero from "@/components/PageHero.astro";
---

<BaseLayout title="成為零售夥伴｜威馬康健" description="申請成為威馬康健經銷夥伴，了解合作對象、申請流程與所需資料。" pageClass="interior-page dealer-page">
  <PageHero background eyebrow="BECOME A PARTNER" title="成為零售夥伴" description="成為威馬康健的通路客戶，透過正式合作販售威馬康健商品，將清楚、可信賴的健康選擇帶給更多消費者。" />

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">WHO CAN APPLY</p>
        <h2 class="section-title">邀請成為我們的銷售夥伴</h2>
        <p>無論您經營實體門市、網路商店、企業採購或區域銷售，只要具備合法營業資格及合適的銷售服務能力，都歡迎提出合作申請。</p>
      </div>
      <div class="value-grid">
        <article><b>01</b><h3>實體零售通路</h3><p>藥局、健康用品店、生活選物店及其他具實體服務據點的零售業者。</p></article>
        <article><b>02</b><h3>網路銷售通路</h3><p>自營電商、平台商店或具完整商品介紹與客服能力的線上通路。</p></article>
        <article><b>03</b><h3>企業與團體採購</h3><p>有員工福利、會員服務、活動贈禮或定期採購需求的企業與組織。</p></article>
        <article><b>04</b><h3>區域經銷夥伴</h3><p>熟悉在地市場，並能依合作規範拓展及服務區域客戶的經銷商。</p></article>
      </div>
    </div>
  </section>

  <section class="section news-section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">HOW TO JOIN</p>
        <h2 class="section-title">四個步驟，開始合作洽談。</h2>
      </div>
      <div class="value-grid">
        <article><b>STEP 01</b><h3>準備基本資料</h3><p>整理公司或商號資料、聯絡窗口、通路類型、銷售區域及預計合作方式。</p></article>
        <article><b>STEP 02</b><h3>提出合作申請</h3><p>前往聯絡頁選擇「成為零售夥伴」，說明現有通路與希望販售的商品方向。</p></article>
        <article><b>STEP 03</b><h3>合作資格審核</h3><p>由威馬康健了解通路定位、銷售規劃及服務能力，並與您進一步洽談。</p></article>
        <article><b>STEP 04</b><h3>確認合作與上架</h3><p>雙方確認供貨、價格、銷售與品牌規範後，依正式約定展開合作。</p></article>
      </div>
      <div class="notice"><strong>申請前請準備：</strong>公司／商號名稱、統一編號、聯絡人與電話、門市地址或電商網址、主要銷售區域、預計販售方式與合作需求。實際合作資格、供貨條件及銷售規範，以雙方確認及正式合約為準。</div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-grid">
      <div><h2>準備好成為零售夥伴嗎？</h2><p>請至聯絡頁選擇「成為零售客戶」，留下您的相關資訊。</p></div>
      <a class="button" href={sitePath("/contact/#contact-form")}>申請成為零售夥伴 →</a>
    </div>
  </section>
</BaseLayout>
