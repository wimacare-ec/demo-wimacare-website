---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import ArticleArchive from "@/components/ArticleArchive.astro";
import { archivePageEntries, totalArchivePages } from "@/lib/pagination";
const news = (await getCollection("news", ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const entries = archivePageEntries(news, 1);
const totalPages = totalArchivePages(news.length);
---
<BaseLayout title="最新消息｜威馬康健" description="查看威馬康健官方聲明、產品新訊、媒體報導與近期活動。" pageClass="interior-page news-list-page">
  <PageHero background eyebrow="NEWS & PRESS" title="最新消息" description="官方聲明、產品新訊、媒體報導與近期活動由 TinaCMS 管理；內容更新後會經 GitHub 與 Cloudflare 自動發布。" />
  <section class="section"><div class="shell">
    <ArticleArchive entries={entries} categories={["官方聲明", "產品新訊", "媒體報導", "近期活動"]} basePath="/news" currentPage={1} totalPages={totalPages} summaryLabel="則消息" />
  </div></section>
</BaseLayout>
